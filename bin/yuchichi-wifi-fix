#!/usr/bin/env bash
# yuchichi-wifi-fix — re-apply MT7925 / yuchichi Wi-Fi mitigations on Linux.
#
# Background: ThinkPad P16s Gen 4 AMD (mt7925e) + home AP "yuchichi" (tri-band
# same SSID) intermittently fails the WPA 4-way handshake after association.
# wpa_supplicant reports "pre-shared key may be incorrect"; NetworkManager then
# re-prompts for the password even though the PSK is correct
# (reason=15 = 4WAY_HANDSHAKE_TIMEOUT). Failures cluster on the 5/6 GHz
# BSSIDs. The first EAPOL TX after a band/firmware path change is often
# dropped; a later retry with the same PSK succeeds.
#
# Mitigations applied by this script:
#   1. options mt7925e disable_aspm=1     — PCIe ASPM off (probe-time; reboot)
#   2. wifi.powersave = 2 globally       — NM default powersave off
#   3. yuchichi profile:
#        band = a                        — prefer 5 GHz (not 2.4 GHz lock)
#        auth-retries = 10               — silent retries; avoid password prompt
#        powersave = 2                   — powersave off on this profile
#        pmf = 1                         — disable PMF / avoid WPA3-FT path
#
# Usage:
#   yuchichi-wifi-fix              # apply (idempotent)
#   yuchichi-wifi-fix apply        # same
#   yuchichi-wifi-fix apply --reconnect   # apply + bounce the link
#   yuchichi-wifi-fix undo         # restore Ubuntu defaults
#   yuchichi-wifi-fix status       # show current state
#
# "Forget network" in the UI creates a new profile and drops these settings —
# re-run `apply` after reconnecting.

set -euo pipefail

SSID="${SSID:-yuchichi}"
ASPM_CONF="/etc/modprobe.d/mt7925e-disable-aspm.conf"
POWERSAVE_CONF="/etc/NetworkManager/conf.d/default-wifi-powersave-on.conf"
AUTH_RETRIES=10

bold()   { printf '\033[1m%s\033[0m' "$*"; }
green()  { printf '\033[32m%s\033[0m' "$*"; }
yellow() { printf '\033[33m%s\033[0m' "$*"; }
tick()   { printf '  %s %s\n' "$(green '✓')" "$*"; }
ring()   { printf '  %s %s\n' "$(yellow '○')" "$*"; }

have_connection() {
  nmcli -t -f NAME connection show 2>/dev/null | grep -Fxq "$SSID"
}

cmd_status() {
  echo "$(bold "yuchichi-wifi-fix status")"
  echo

  if [[ -f "$ASPM_CONF" ]]; then
    tick "ASPM override present ($ASPM_CONF)"
  else
    ring "ASPM override missing"
  fi
  local live_aspm="?"
  [[ -r /sys/module/mt7925e/parameters/disable_aspm ]] \
    && live_aspm="$(cat /sys/module/mt7925e/parameters/disable_aspm)"
  if [[ "$live_aspm" == "Y" ]]; then
    tick "live disable_aspm=$live_aspm (active this boot)"
  else
    ring "live disable_aspm=$live_aspm (reboot needed if conf exists)"
  fi

  if [[ -f "$POWERSAVE_CONF" ]] && grep -q 'wifi.powersave\s*=\s*2' "$POWERSAVE_CONF"; then
    tick "global wifi.powersave=2 (off)"
  else
    ring "global wifi.powersave is not 2"
  fi

  if have_connection; then
    local band powersave pmf retries
    band="$(nmcli -g 802-11-wireless.band connection show "$SSID" 2>/dev/null || true)"
    powersave="$(nmcli -g 802-11-wireless.powersave connection show "$SSID" 2>/dev/null || true)"
    pmf="$(nmcli -g 802-11-wireless-security.pmf connection show "$SSID" 2>/dev/null || true)"
    retries="$(nmcli -g connection.auth-retries connection show "$SSID" 2>/dev/null || true)"
    [[ "$band" == "a" ]] && tick "profile band=a (5 GHz)" || ring "profile band=${band:-unset}"
    [[ "$retries" == "$AUTH_RETRIES" ]] \
      && tick "profile auth-retries=$AUTH_RETRIES" \
      || ring "profile auth-retries=${retries:-unset}"
    [[ "$powersave" == "2" || "$powersave" == "disable" ]] \
      && tick "profile powersave=disable" || ring "profile powersave=${powersave:-unset}"
    [[ "$pmf" == "1" || "$pmf" == "disable" ]] \
      && tick "profile pmf=disable" || ring "profile pmf=${pmf:-unset}"
    echo
    echo "  associated:"
    nmcli -t -f ACTIVE,SSID,BSSID,CHAN,FREQ,SIGNAL,RATE device wifi 2>/dev/null \
      | grep '^yes' | sed 's/^/    /' || echo "    (not connected)"
  else
    ring "no NetworkManager connection named '$SSID'"
  fi
}

cmd_apply() {
  local reconnect=0
  for arg in "$@"; do
    case "$arg" in
      --reconnect|-r) reconnect=1 ;;
    esac
  done

  if ! have_connection; then
    echo "ERROR: no connection named '$SSID'."
    echo "Connect once in the UI, then re-run: yuchichi-wifi-fix apply"
    exit 1
  fi

  echo "$(bold "Applying mitigations for '$SSID'...")"
  echo

  echo ">>> 1/3  PCIe ASPM off for mt7925e"
  sudo tee "$ASPM_CONF" >/dev/null <<'CONF'
# Disable PCIe ASPM on MediaTek MT7925 — reduces 4-way handshake timeouts
# that NetworkManager mis-reports as a wrong Wi-Fi password.
options mt7925e disable_aspm=1
CONF

  echo ">>> 2/3  Global NetworkManager Wi-Fi powersave = off"
  sudo tee "$POWERSAVE_CONF" >/dev/null <<'CONF'
[connection]
# 2 = disable. Ubuntu ships 3=enable; recreating a Wi-Fi profile re-inherits it.
wifi.powersave = 2
CONF
  sudo nmcli general reload conf

  echo ">>> 3/3  Profile: band=a, auth-retries=$AUTH_RETRIES, powersave off, pmf off"
  nmcli connection modify "$SSID" \
    802-11-wireless.band a \
    connection.auth-retries "$AUTH_RETRIES" \
    802-11-wireless.powersave 2 \
    802-11-wireless-security.pmf 1

  echo
  cmd_status

  if [[ "$reconnect" -eq 1 ]]; then
    echo
    echo ">>> Reconnecting '$SSID'..."
    nmcli connection down "$SSID" || true
    nmcli connection up "$SSID"
    nmcli -t -f ACTIVE,SSID,BSSID,CHAN,FREQ,SIGNAL,RATE device wifi \
      | grep '^yes' | sed 's/^/  /' || true
  fi

  local live_aspm
  live_aspm="$(cat /sys/module/mt7925e/parameters/disable_aspm 2>/dev/null || echo '?')"
  if [[ "$live_aspm" != "Y" ]]; then
    echo
    echo "Note: disable_aspm is $live_aspm — reboot once for ASPM:  sudo reboot"
  fi
}

cmd_undo() {
  echo "$(bold "Undoing mitigations...")"
  echo
  echo ">>> Removing mt7925e ASPM override"
  sudo rm -f "$ASPM_CONF"

  echo ">>> Restoring Ubuntu global wifi.powersave=3"
  sudo tee "$POWERSAVE_CONF" >/dev/null <<'CONF'
[connection]
wifi.powersave = 3
CONF
  sudo nmcli general reload conf

  if have_connection; then
    echo ">>> Clearing profile overrides on '$SSID'"
    nmcli connection modify "$SSID" \
      802-11-wireless.band '' \
      connection.auth-retries -1 \
      802-11-wireless.powersave 0 \
      802-11-wireless-security.pmf 0
  else
    echo "(no connection named '$SSID' — skipped profile reset)"
  fi

  echo
  echo "Undone. Reboot to restore ASPM:  sudo reboot"
}

usage() {
  sed -n '2,30p' "$0" | sed 's/^# \?//'
}

main() {
  local cmd="${1:-apply}"
  shift || true
  case "$cmd" in
    apply|enable)  cmd_apply "$@" ;;
    undo|disable)  cmd_undo "$@" ;;
    status)        cmd_status ;;
    -h|--help|help) usage ;;
    *)
      echo "Unknown command: $cmd"
      usage
      exit 1
      ;;
  esac
}

main "$@"
